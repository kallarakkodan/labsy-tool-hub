# Labsy Tool Hub — Docker Compose environment.
#
# Copy this to `.env.docker` (gitignored) and fill in the two values with no
# default: ADMIN_PASSWORD_HASH and AUTH_SECRET. Everything else already has a
# sane default baked into the image (see Dockerfile's ENV block) matching this
# file — uncomment a line only to override it.
#
# See deploy/docker/DOCKER.md for the full setup walkthrough.

# --- Required — the image will not boot without these ---

# Generate with: docker compose run --rm app node deploy/docker/gen-hash.cjs
# Every $ MUST be escaped as \$, exactly as the generator prints it — dotenv
# expands a bare $16384 away and login silently never works again.
ADMIN_PASSWORD_HASH=""

# >=32 random bytes. Generate with: openssl rand -base64 48
AUTH_SECRET=""

# --- Already defaulted in the image — uncomment to override ---

# NEXT_PUBLIC_APP_VERSION="1.0.0"
# DATABASE_URL="file:/data/db.sqlite"
# STORAGE_ROOT="/srv/downloads"
# CHUNK_SIZE="16777216"
# UPLOAD_SUBDIR="uploads"
# UPLOAD_TTL_HOURS="24"
# SESSION_TTL_HOURS="8"

# Set to "false" ONLY if nothing in front of this container terminates TLS —
# e.g. you are hitting it directly over plain HTTP for local testing. Leave
# "true" (the default) for any real deployment; see DOCKER.md.
# COOKIE_SECURE="true"

# USE_X_ACCEL="false"
