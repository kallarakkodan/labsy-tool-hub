# Labsy Tool Hub — authoritative list of environment variables (CONTEXT §3).
#
# Real values live in .env.local (dev, gitignored) and /etc/labsy-hub/env
# (production, mode 0640, root:labsy). Never commit a filled-in copy.
#
# lib/env.ts parses this with Zod at boot and the process EXITS NON-ZERO if
# anything below is missing or wrong. Failing at start beats failing at 2am.

# --- Core ---
DATABASE_URL="file:./prisma/dev.db"          # prod: file:/var/lib/labsy-hub/db.sqlite
STORAGE_ROOT="./storage"                     # prod: /srv/downloads — MUST exist and be readable
NEXT_PUBLIC_APP_VERSION="1.0.0"              # shown in the header tag

# --- Auth ---
ADMIN_PASSWORD_HASH=""                       # scrypt hash; generate: pnpm gen:hash and paste the
                                             # line it prints. Every $ MUST be escaped as \$ —
                                             # dotenv expands $16384 away and login silently
                                             # never works. Boot refuses the mangled form.
AUTH_SECRET=""                               # >=32 random bytes; openssl rand -base64 48
SESSION_TTL_HOURS="8"
COOKIE_SECURE="true"                         # dev-only escape hatch; boot FAILS if false in production

# --- Uploads ---
CHUNK_SIZE="16777216"                        # 16 MiB. NPM's client_max_body_size must exceed this
UPLOAD_SUBDIR="uploads"                      # relative to STORAGE_ROOT
UPLOAD_TTL_HOURS="24"

# --- Serving ---
USE_X_ACCEL="false"                          # leave false: Node streams. Only true if NPM is
                                             # co-located AND has the storage root mounted (PRD §12.4)
X_ACCEL_PREFIX="/_protected"                 # must match the proxy's `internal` location
